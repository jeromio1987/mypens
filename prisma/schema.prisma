generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct :5432 — use for migrate (pgbouncer :6543 hangs). See Audit 7 H1.
  directUrl = env("DIRECT_URL")
}

model WeightEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String

  scaleKg      Float
  bodyFatPct   Float?
  /// Reference-only (Tanita/Garmin import). Not used in BMR or energy math — Katch uses BF% → FFM (M1).
  muscleMassKg Float?
  boneMassKg   Float?
  bodyWaterPct Float?
  visceralFat  Int?

  creatineDoseG     Float   @default(0)
  creatineDaysOn    Int     @default(0)
  creatinePostLoad  Boolean @default(false) // true = transitioned from loading phase → stays saturated
  alcoholUnits      Float   @default(0)
  hoursSinceAlcohol Float   @default(48)
  carbsG            Float   @default(0)
  hardTraining      Boolean @default(false)
  morningReading    Boolean @default(true)

  // Phase 5 confounders
  highSodium      Boolean @default(false) // high sodium day → water retention
  restaurantMeal  Boolean @default(false) // proxy for hidden sodium
  flightDay       Boolean @default(false) // immobility / fluid pooling
  illnessDay      Boolean @default(false) // inflammation → scale unreliable

  creatineRetentionKg Float   @default(0)
  alcoholRetentionKg  Float   @default(0)
  glycogenRetentionKg Float   @default(0)
  trueWeightKg        Float   @default(0)
  tanitaReliable      Boolean @default(true)
  source              String  @default("manual") // manual | garmin | healthkit
}

// Phase 2 — Food Logging
model FoodEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String
  meal      String   @default("snack") // breakfast | lunch | dinner | snack

  name     String
  kcal     Float @default(0)
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)
  fiberG   Float @default(0)
  notes    String?
  // Present micronutrients only — JSON object e.g. {"sodiumMg":120,"ironMg":2.1}
  microsJson String?
  // Soft display tags — JSON string array e.g. ["high_protein"]
  tagsJson   String?
  // Enrichment provenance from review engine — JSON FoodEnrichmentMeta (macros never stored here)
  enrichmentJson String?
}

// Phase 3 — Sleep
model SleepEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String   @unique

  bedtime  String  // HH:MM e.g. "22:30"
  wakeTime String  // HH:MM e.g. "06:45"
  hours    Float   // auto-calculated
  /// 1–5 from HRV bands; null = not measured (never invent 3)
  quality  Int?
  hrv      Float?  // optional HRV in ms
  notes    String?
  /// Origin of the row: manual | healthconnect | garmin
  source   String  @default("manual")
  /// External session id when source is healthconnect/garmin
  externalId String? @unique

  @@index([source])
}

// Phase 3 — Training
model TrainingEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String

  exercise String
  sets     Int
  reps     Int
  weightKg Float    @default(0)
  rpe      Int?     // 1–10
  notes    String?
  volume   Float    @default(0) // sets × reps × weightKg (computed on save)
  // Session active burn from device (Garmin/Strava/HC). Prefer this over notes scrape.
  calories Int?

  // Provenance — where this entry came from
  source      String  @default("manual") // manual | strava | garmin | healthkit | healthconnect
  externalId  String? // unique id at the source (e.g. Strava activity id) — used for de-duplication
  externalUrl String? // deep link back to the source activity
  externalRaw String? // JSON blob of the raw source payload, kept for reference

  @@unique([source, externalId])
}

model Programme {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  name      String
  active    Boolean        @default(false)
  days      ProgrammeDay[]
}

model ProgrammeDay {
  id          String             @id @default(cuid())
  programmeId String
  dayLabel    String
  order       Int
  programme   Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  exercises   ProgrammeExercise[]

  @@index([programmeId])
}

model ProgrammeExercise {
  id       String       @id @default(cuid())
  dayId    String
  name     String
  sets     Int
  reps     String
  weightKg Float?
  order    Int
  day      ProgrammeDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

// Strava — OAuth connection (single-user app, so userId is a placeholder for now)
model StravaConnection {
  id           String   @id @default(cuid())
  userId       String   @unique @default("default")
  athleteId    String
  accessToken  String
  refreshToken String
  expiresAt    Int      // unix seconds
  scope        String?
  lastSyncAt   DateTime?
  // Webhook + background sync state
  webhookId           Int?    // Strava push_subscriptions id (app-level)
  webhookVerifyToken  String? // verify token used during subscribe handshake
  lastError           String? // most recent sync error message (webhook or cron)
  lastErrorAt         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Garmin Connect — OAuth2 PKCE connection
model GarminConnection {
  id             String    @id @default(cuid())
  userId         String    @unique @default("default")
  garminUserId   String    @default("")
  accessToken    String
  refreshToken   String
  expiresAt      Int       // unix seconds
  scope          String?
  lastSyncAt     DateTime?
  // Background sync state — Garmin Push (Activity Ping Service) is configured
  // app-level in the developer portal, but we still record whether the initial
  // backfill has been kicked off so the UI can reflect it.
  pingSubscribed Boolean   @default(false)
  lastError      String?
  lastErrorAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Apple HealthKit — pairing token issued to a companion mobile client
model HealthkitConnection {
  id          String    @id @default(cuid())
  userId      String    @unique @default("default")
  pairingToken String   @unique
  deviceLabel String?
  lastSyncAt  DateTime?
  // Server-side: most recent failure while ingesting a push from the companion.
  lastError         String?
  lastErrorAt       DateTime?
  // Client-side: most recent background-sync failure reported by the companion
  // (e.g. HealthKit query failed, network unreachable from the phone). The
  // companion attaches it to its next successful push so the dashboard can
  // surface "your phone tried to sync and failed" without server access.
  lastClientError   String?
  lastClientErrorAt DateTime?
  // Cron-job idempotency: when we last notified the user that this pairing
  // had gone silent past MOBILE_STALE_THRESHOLD_HOURS. We only re-notify
  // after a successful sync advances `lastSyncAt` past this timestamp.
  lastStaleNotifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Android Health Connect — pairing token issued to a companion mobile client
model HealthConnectConnection {
  id          String    @id @default(cuid())
  userId      String    @unique @default("default")
  pairingToken String   @unique
  deviceLabel String?
  // When true, /ingest promotes new sessions straight to TrainingEntry
  // (skips the review queue on /integrations).
  autoImportOnIngest Boolean @default(false)
  lastSyncAt  DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  lastClientError   String?
  lastClientErrorAt DateTime?
  lastStaleNotifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Inbox of workouts pushed by mobile companions (HealthKit / Health Connect)
// awaiting review before being promoted to TrainingEntry.
model PushedWorkout {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  source      String   // healthkit | healthconnect
  externalId  String
  date        String   // yyyy-mm-dd local
  exercise    String
  notes       String?
  durationSec Int      @default(0)
  distanceM   Float    @default(0)
  calories    Float    @default(0)
  raw         String   // JSON blob

  @@unique([source, externalId])
}

// Persistent "tombstone" of a pushed workout the user explicitly skipped.
// Outlives the PushedWorkout row so re-pushes from the companion app (which
// keep the same externalId / UUID) can be silently dropped at /ingest time.
//
// Retention: rows are auto-cleaned once `skippedAt` is older than
// SKIPPED_TOMBSTONE_RETENTION_DAYS (default 90 — see
// `lib/integrations/_shared/skippedTombstoneRetention.ts`). The companion
// app's lookback is much shorter than this window, so an expired tombstone
// could never be re-triggered by a re-push anyway, and keeping it forever
// would just bloat the "Show skipped" list. Cleanup happens via the
// `/api/cron/cleanup-skipped-tombstones` cron and as a fire-and-forget on
// the activities GET when `?showSkipped=1` is requested.
model SkippedPushedWorkout {
  id         String   @id @default(cuid())
  source     String   // healthkit | healthconnect
  externalId String
  skippedAt  DateTime @default(now())
  // Snapshot of the discarded PushedWorkout so the "Show skipped" UI can
  // display something meaningful after the live row is gone. Nullable because
  // older tombstones predate this column.
  date       String?
  exercise   String?
  notes      String?

  @@unique([source, externalId])
}

// Garmin — bulk historical activity archive imported from .fit files
// (separate from GarminConnection which handles live OAuth sync).
model GarminActivity {
  id          String   @id
  createdAt   DateTime @default(now())
  fitFileId   String   @unique
  date        String
  name        String
  sport       String
  subSport    String?
  durationSec Float
  /// Session start (UTC) for overlap dedup vs Strava/HC (E4/E5). Optional for legacy rows.
  startedAt   DateTime?
  distanceM   Float?
  elevationM  Float?
  avgHr       Int?
  maxHr       Int?
  calories    Int?
  avgSpeedMs  Float?
  maxSpeedMs  Float?
}

// Garmin Connect dump — daily wellness metrics (stress, HRV, steps, body
// battery, resting HR, SpO2, …). One row per (date, kind). Filled by
// scripts/import-garmin-dump.py from DI_CONNECT JSON (e.g. UDSFile_*.json).
model GarminDailyMetric {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  date       String // yyyy-mm-dd
  // stress | hrv | steps | steps_hc | body_battery | resting_hr | spo2 | respiration |
  // calories | active_calories | active_calories_hc | resting_calories | total_calories | other
  // HC companion uses *_hc side-kinds so Garmin canonical kinds are never overwritten (D1).
  kind       String
  valueNum   Float?
  valueText  String?
  unit       String?
  sourceFile String?
  // Optional bounded JSON of the source fields used.
  raw        String?

  @@unique([date, kind])
  @@index([kind, date])
}

// Phase 4 — Body Measurements
model BodyMeasurement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String   @unique

  waistCm      Float?
  chestCm      Float?
  hipsCm       Float?
  leftArmCm    Float?
  rightArmCm   Float?
  leftThighCm  Float?
  rightThighCm Float?
  neckCm       Float?
  notes        String?
  photoPath    String?  // /uploads/measurements/<file>.jpg — progress photo
}

// Phase 5 — Event / Trip tagging
model EventTag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String   // travel | illness | holiday | diet-break | competition | other
  label     String
  startDate String
  endDate   String
  notes     String?
}

// Phase 6 — Goals
model Goal {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  module      String   // weight | measurements | training
  metricKey   String   // scaleKg | waistCm | weeklySessions
  targetValue Float
  startValue  Float
  startDate   String
}

// PENS — Daily Mode Entry
model DayEntry {
  id        String   @id @default(cuid())
  date      String   @unique
  mode      String   // locked_in | balanced | off
  tags      String   @default("[]") // JSON array: alcohol | heavy_meal | travel | late_night | intense_training
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 4 — Presets (quick-entry templates per module)
model Preset {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  module    String   // weight | food | sleep | training
  name      String
  data      String   // JSON blob of form fields
  usedCount Int      @default(0)
}

// Daily journal — shared with mobile JournalEntry table
model JournalEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String   @unique
  title     String?
  content   String
  mood      Int? // 1–5
  notes     String?
  // /uploads/journal/<file>.webm — optional voice attachment
  voicePath        String?
  voiceDurationSec Int?
}

// Read-only weight snapshot links (token digest + revoke)
model ShareLink {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  tokenDigest String    @unique
}

// Single-user app: one row; tier gates premium features.
model UserSettings {
  id               String   @id @default("default")
  tier             String   @default("free") // "free" | "premium"
  stripeCustomerId String?
  // Lab screens: sleep/training context windows (never causal claims).
  labsWearableContextEnabled Boolean @default(true)
  // Softer copy + educational retest-interval hints (prevention framing).
  labsLongevityLensEnabled   Boolean @default(false)
  // Optional body profile for Mifflin–St Jeor BMR (energy ledger). Soft estimates only.
  heightCm   Float?
  birthYear  Int?
  sex        String? // "male" | "female"
  // Training load HR zones — null → engines default to 185.
  hrMax      Int?
  // Body phase (WP 2.3) — steers fueling targets + planner bias. Was file store.
  bodyPhase              String  @default("maintain") // cut|bulk|recomp|maintain
  bodyPhaseStartedAt     String? // yyyy-mm-dd
  bodyPhaseKgPerWeek     Float   @default(0.4)
  bodyPhaseExpectedEndAt String?
  // Bumped on logout to revoke all web session cookies. Not used by mobile bearer
  // or read-only share-link / snapshot tokens (those are separate secrets).
  sessionVersion Int @default(0)
  updatedAt DateTime @updatedAt
}

// =============================================================================
// BLOODWORK — structured lab panels (manual entry v1; OCR/import later).
// =============================================================================

model BloodworkPanel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // yyyy-mm-dd — calendar date of draw / report
  drawDate  String
  labName   String?
  fasting   Boolean  @default(false)
  notes     String?
  markers   BloodworkMarker[]

  @@index([drawDate])
}

model BloodworkMarker {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  panelId   String
  panel     BloodworkPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  // Stable slug for charts (e.g. ferritin, hba1c, alt)
  code      String
  label     String
  valueNum  Float?
  // Qualitative or bounded results, e.g. "<2", "negative"
  valueText String?
  unit      String?
  refLow    Float?
  refHigh   Float?
  sortOrder Int            @default(0)

  @@index([panelId])
  @@index([code])
}

// Singleton cache for Claude-generated weekly Verdict prose
model AiVerdictCache {
  id          String   @id @default("singleton")
  summary     String
  generatedAt DateTime @default(now())
}

// =====================================================================
// WEEKLY FEEDBACK LOOP — Claude-generated deep weekly review.
// Combines an analysis of the week's health/life data with an analysis
// of how the user worked with Claude/Cursor (prompt quality, project
// execution) parsed from local agent transcripts. Rows are produced by
// `scripts/weekly-feedback.mjs` (runs locally, where the transcripts
// live) and are read-only from the web + mobile clients.
//
// JSON-bearing columns are stored as TEXT (the same convention used by
// DayEntry.tags / RecoveryEntry.supplements) to keep the model portable.
// =====================================================================
model WeeklyFeedbackReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // ISO week the report covers. `weekOf` is the Monday (yyyy-mm-dd),
  // `weekEnd` the Sunday. `weekOf` is unique so re-runs upsert in place.
  weekOf  String @unique
  weekEnd String

  // Prose sections produced by Claude (or a deterministic fallback when
  // no ANTHROPIC_API_KEY is available).
  combinedSummary    String
  healthAnalysis     String
  claudeWorkAnalysis String

  // Short actionable lists — JSON arrays of strings.
  wins          String @default("[]")
  improvements  String @default("[]")
  healthActions String @default("[]")

  // Raw deterministic metrics that fed the analysis — JSON blob.
  metrics String @default("{}")

  // Which model generated the prose (null = deterministic fallback).
  model String?

  generatedAt DateTime @default(now())
}

// Multi-horizon period review (3m / 6m / 12m / all history).
// Produced by `scripts/analyze-periods.mjs`. Weekly Feedback must not reuse
// this as a stand-in for an empty ISO week — advice is period-scoped.
model PeriodReviewReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // End date of the analysis window (yyyy-mm-dd). Unique so re-runs upsert.
  asOf     String @unique
  headline String
  // Full structured report from analyzePeriods() — JSON text.
  reportJson String @default("{}")

  generatedAt DateTime @default(now())
}

// Phase 6 — Adaptive Sports Planner: user-declared goal + weekend long-day preference.
model PlannerGoal {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  active     Boolean  @default(true)
  // vo2max | bodyfat | marathon | custom
  kind       String
  label      String
  targetNum  Float?
  targetText String?
  raceDate   String? // yyyy-mm-dd
  // saturday | sunday — only long session day
  longDay    String   @default("saturday")
  // JSON string array: running | cycling | core | gym
  sportsJson String   @default("[\"running\",\"gym\"]")
  notes      String?
}

model PlannerWeek {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // Monday of the planned week (yyyy-mm-dd)
  weekOf    String
  goalId    String?
  planJson  String   @default("{}")
  accepted  Boolean  @default(false)

  @@unique([weekOf])
  @@index([goalId])
}

// =====================================================================
// ANCHOR — recovery & ADD self-management module.
// All models below are ADDITIVE; no existing model is altered. Local-only,
// single-user. Sensitive data — never logged to console, never serialized
// off-host except via the explicit /api/anchor/export endpoint.
// =====================================================================

// One row per calendar date — the daily check-in.
model RecoveryEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  date      String   @unique // yyyy-mm-dd local

  // Hard substance/behavior flags
  alcoholDrinks Int     @default(0) // 0 = clean
  cocaineUsed   Boolean @default(false)
  escortUsed    Boolean @default(false)

  // Soft signals (1-5)
  mood        Int? // 1 (very low) — 5 (very good)
  energy      Int? // 1 — 5
  sleepHours  Float?

  // Supplement checklist (JSON array of strings, e.g. ["NAC","Creatine"])
  supplements String @default("[]")

  // Free text — kept short on purpose
  notes String?
}

// Each tap on "I'm having a craving NOW" creates one row.
model CravingEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) // = the moment of craving

  // What it was for: alcohol | cocaine | escort | other
  target   String  @default("alcohol")
  // Free-text trigger: "Friday 18:00 work stress"
  trigger  String?
  // What you did about it: cold_shower | walk | training | gaming | breath | other
  action   String  @default("cold_shower")
  // Outcome: resisted | partial | slipped
  outcome  String  @default("resisted")
  notes    String?
}

// Singleton row holding the user's cost assumptions and clean-day targets.
model RecoverySettings {
  id        String   @id @default("default")
  updatedAt DateTime @updatedAt

  // Per-unit costs (EUR) for the money-saved calculator
  drinkCostEur   Float @default(7)   // average price of one drink
  cocaineGramEur Float @default(70)  // street price per gram
  escortNightEur Float @default(1000)

  // Baseline weekly consumption BEFORE the protocol started.
  // Used to compute "drinks avoided" = baseline_per_day - actual.
  baselineDrinksPerWeek Float @default(45)
  baselineCocaineGramsPerMonth Float @default(3)
  baselineEscortsPerMonth      Float @default(1.5)

  // The reset start date. Streaks and money-saved are measured from here.
  resetStartDate String @default("2026-05-01")

  // Phase target lengths (days)
  phase1ResetDays Int @default(45)
}

// Treatment milestones — appointments, med starts, phase boundaries.
model RecoveryMilestone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String   // yyyy-mm-dd
  kind      String   // appointment | med_start | phase_change | note
  label     String
  notes     String?
}

// In-app notification inbox. Currently the only producer is the
// stale-pairing cron, but the model is intentionally generic so future
// alerts (goal milestones, weekly recaps, etc.) can reuse it.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @default("default")
  // Stable category, e.g. "stale_pairing". Used by clients that want to
  // group or filter; not enforced as a foreign key on purpose.
  kind      String
  title     String
  body      String
  // Optional in-app link (e.g. "/integrations").
  href      String?
  createdAt DateTime  @default(now())
  // Null until the user dismisses / marks read.
  readAt    DateTime?

  @@index([userId, readAt, createdAt])
}

// =====================================================================
// INVESTING — Tier 1-C / Tier 2-E,F,H (personal single-user hub)
// Watchlist, macro regime log, calendar merge (static + optional Finnhub),
// optional ntfy on regime change. Not financial advice — tooling only.
// =====================================================================

model InvestingWatchlistTicker {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  symbol    String // upper-case ticker, e.g. CCJ
  sortOrder Int      @default(0)

  @@unique([symbol])
}

// Regime log — each row applies from `effectiveDate` until the next row’s `effectiveDate`.
model MacroRegimeSnapshot {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  effectiveDate String // yyyy-mm-dd (inclusive start of this regime stretch)
  regime        String // risk_on | risk_off | neutral | mixed | (custom slug)
  notes         String?

  @@index([effectiveDate])
}

// User-typed or imported one-off calendar rows (earnings day, Fed speaker, etc.)
model InvestingManualEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      String // yyyy-mm-dd
  title     String
  kind      String   @default("manual") // manual | earnings_note | other
  symbol    String? // optional filter to watchlist context
}

// =====================================================================
// CLUBROOM — multi-user leaderboard (Tier 2-C)
// Privacy-first: only gamification scores shared, never raw health values.
// =====================================================================

model Club {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  inviteCode String       @unique @default(cuid())
  createdAt  DateTime     @default(now())
  members    ClubMember[]
}

model ClubMember {
  id          Int      @id @default(autoincrement())
  clubId      Int
  userId      String
  displayName String
  joinedAt    DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id])

  @@unique([clubId, userId])
}
